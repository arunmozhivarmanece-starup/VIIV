# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://viiv.example

# Analytics — leave empty to disable. No credentials are committed.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Webinar registrations — server-side forwarding target (CRM / automation webhook).
# When empty, registrations are validated and logged only.
WEBINAR_WEBHOOK_URL=
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true
